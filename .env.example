# PostgreSQL connection used by the AITSM server. Copy this file to `.env` and
# replace the sample values with the database credentials configured on this machine.
DB_URL=jdbc:postgresql://127.0.0.1:5432/aitsm
DB_USER=postgres
DB_PASSWORD=change-me
# Production example: jdbc:postgresql://db.internal:5432/aitsm?sslmode=verify-full
# Cloud SQL: jdbc:postgresql:///aitsm?cloudSqlInstance=PROJECT:REGION:INSTANCE&socketFactory=com.google.cloud.sql.postgres.SocketFactory&sslmode=disable

APP_ENV=development
PORT=8070
COMPANY_NAME=Example Company
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8070
SESSION_ABSOLUTE_HOURS=12
SESSION_INACTIVITY_MINUTES=30
INVITATION_TTL_HOURS=24
PROFILE_UPLOAD_DIR=uploads/profile-photos
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# Public base URL used in application links and security checks.
# Local: http://127.0.0.1:8070 | Production: https://your-domain.example
APP_BASE_URL=http://127.0.0.1:8070

# One-time/bootstrap owner account. Inject through deployment secrets and remove
# SUPERADMIN_PASSWORD after the initial account has been created.
BOOTSTRAP_SUPERADMIN=false
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=System Super Admin
SUPERADMIN_COMPANY=Example Company
SUPERADMIN_DEPARTMENT=Platform

# Local AI model preference. Ollama is not contacted until the secure bridge is installed.
OLLAMA_MODEL=qwen3:8b
AI_TIMEOUT_MILLIS=60000

# Transactional email (Brevo SMTP). Keep the real SMTP key only in `.env`
# or your deployment secret manager.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=your-verified-sender@example.com
SMTP_FROM_NAME=AITSM No Reply
SMTP_REPLY_TO=
SMTP_STARTTLS=true
AUTH_EXPOSE_DEV_VERIFICATION_CODE=false
# Versioned collector release. Keep the checksum pinned when changing the URL.
COLLECTOR_INSTALLER_URL=https://github.com/suppyooww-rgb/AITSMSystem/releases/download/collector-v1.3.1/AITSMCollectorSetup.exe
COLLECTOR_INSTALLER_SHA256=1E28FB693134A468D5952AF8FDDD914DB03CDF47A9FE4A9D4EC0009CD7EB000C
